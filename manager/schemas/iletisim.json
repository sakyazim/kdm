{
  "file": "data/pages/iletisim.json",
  "label": "İletişim Sayfası",
  "preview": "iletisim.html",
  "description": "İletişim sayfasının tüm içeriği: üst bant (hero), içerik bölümleri ve yardım bölümü.",
  "fields": [
    {
      "key": "hero",
      "label": "Üst Bant (Hero)",
      "type": "object",
      "required": true,
      "fields": [
        { "key": "title", "label": "Başlık", "type": "lang", "required": true },
        { "key": "description", "label": "Açıklama", "type": "lang" },
        { "key": "icon", "label": "İkon (FontAwesome)", "type": "icon", "hint": "Örn: fas fa-envelope" },
        {
          "key": "breadcrumb",
          "label": "Gezinti Yolu (Breadcrumb)",
          "type": "array",
          "itemLabel": "Adım",
          "itemFields": [
            { "key": "text", "label": "Metin", "type": "lang", "required": true },
            { "key": "url", "label": "Bağlantı", "type": "url" }
          ]
        }
      ]
    },
    {
      "key": "content",
      "label": "İçerik Bölümleri",
      "type": "array",
      "itemLabel": "Bölüm",
      "itemFields": [
        { "key": "id", "label": "Bölüm ID", "type": "text" },
        {
          "key": "components",
          "label": "Bileşenler",
          "type": "components",
          "components": {
            "heading": {
              "label": "Başlık",
              "fields": [
                { "key": "title", "label": "Başlık", "type": "lang", "required": true },
                { "key": "icon", "label": "İkon", "type": "icon" },
                { "key": "id", "label": "ID", "type": "text" }
              ]
            },
            "icon-list": {
              "label": "İkon Listesi",
              "fields": [
                {
                  "key": "items",
                  "label": "Öğeler",
                  "type": "array",
                  "itemLabel": "Öğe",
                  "itemFields": [
                    { "key": "icon", "label": "İkon", "type": "icon" },
                    { "key": "text", "label": "Metin", "type": "lang", "required": true }
                  ]
                }
              ]
            },
            "info-box": {
              "label": "Bilgi Kutusu",
              "fields": [
                { "key": "title", "label": "Başlık", "type": "lang" },
                { "key": "titleIcon", "label": "Başlık İkonu", "type": "icon" },
                { "key": "content", "label": "İçerik", "type": "lang", "required": true }
              ]
            },
            "map-embed": {
              "label": "Harita",
              "fields": [
                { "key": "embedUrl", "label": "Harita Bağlantısı", "type": "url", "required": true },
                { "key": "width", "label": "Genişlik", "type": "text" },
                { "key": "height", "label": "Yükseklik", "type": "text" },
                { "key": "borderRadius", "label": "Köşe Yuvarlaklığı", "type": "text" },
                { "key": "allowFullscreen", "label": "Tam Ekran İzni", "type": "boolean" },
                { "key": "loading", "label": "Yükleme", "type": "select", "options": ["lazy", "eager"] }
              ]
            },
            "alert": {
              "label": "Uyarı Kutusu",
              "fields": [
                { "key": "icon", "label": "İkon", "type": "icon" },
                { "key": "content", "label": "İçerik", "type": "lang", "required": true }
              ]
            },
            "table": {
              "label": "Tablo",
              "fields": [
                {
                  "key": "headers",
                  "label": "Sütun Başlıkları",
                  "type": "array",
                  "itemLabel": "Sütun",
                  "itemFields": [
                    { "key": "tr", "label": "TR", "type": "text", "required": true },
                    { "key": "en", "label": "EN", "type": "text", "required": true }
                  ]
                },
                {
                  "key": "rows",
                  "label": "Satırlar",
                  "type": "array",
                  "itemLabel": "Satır",
                  "itemFields": [
                    { "key": "icon", "label": "İkon", "type": "icon" },
                    {
                      "key": "cells",
                      "label": "Hücreler (JSON)",
                      "type": "raw",
                      "hint": "Örn: [{\"tr\":\"Birim\",\"en\":\"Unit\"}, \"1728\"]"
                    },
                    {
                      "key": "highlightColumns",
                      "label": "Vurgulanacak Sütunlar",
                      "type": "array",
                      "itemType": "number",
                      "itemLabel": "Sütun No"
                    }
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    {
      "key": "helpSection",
      "label": "Yardım Bölümü",
      "type": "object",
      "required": true,
      "fields": [
        { "key": "title", "label": "Başlık", "type": "lang" },
        { "key": "description", "label": "Açıklama", "type": "lang" },
        {
          "key": "buttons",
          "label": "Butonlar",
          "type": "array",
          "itemLabel": "Buton",
          "itemFields": [
            { "key": "icon", "label": "İkon", "type": "icon" },
            { "key": "text", "label": "Metin", "type": "lang", "required": true },
            { "key": "link", "label": "Bağlantı", "type": "url", "required": true }
          ]
        }
      ]
    }
  ]
}
