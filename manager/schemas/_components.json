{
  "label": "Ortak Bileşen Kayıt Defteri",
  "components": {
    "heading": {
      "label": "Başlık",
      "fields": [
        {
          "key": "title",
          "label": "Başlık",
          "type": "lang",
          "required": true
        },
        {
          "key": "icon",
          "label": "İkon",
          "type": "icon"
        },
        {
          "key": "id",
          "label": "ID",
          "type": "text"
        }
      ]
    },
    "icon-list": {
      "label": "İkon Listesi",
      "fields": [
        {
          "key": "items",
          "label": "Öğeler",
          "type": "array",
          "itemLabel": "Öğe",
          "itemFields": [
            {
              "key": "icon",
              "label": "İkon",
              "type": "icon"
            },
            {
              "key": "text",
              "label": "Metin",
              "type": "lang",
              "required": true
            }
          ]
        }
      ]
    },
    "info-box": {
      "label": "Bilgi Kutusu",
      "fields": [
        {
          "key": "title",
          "label": "Başlık",
          "type": "lang"
        },
        {
          "key": "titleIcon",
          "label": "Başlık İkonu",
          "type": "icon"
        },
        {
          "key": "content",
          "label": "İçerik",
          "type": "lang",
          "required": true
        }
      ]
    },
    "map-embed": {
      "label": "Harita",
      "fields": [
        {
          "key": "embedUrl",
          "label": "Harita Bağlantısı",
          "type": "url",
          "required": true
        },
        {
          "key": "width",
          "label": "Genişlik",
          "type": "text"
        },
        {
          "key": "height",
          "label": "Yükseklik",
          "type": "text"
        },
        {
          "key": "borderRadius",
          "label": "Köşe Yuvarlaklığı",
          "type": "text"
        },
        {
          "key": "allowFullscreen",
          "label": "Tam Ekran İzni",
          "type": "boolean"
        },
        {
          "key": "loading",
          "label": "Yükleme",
          "type": "select",
          "options": [
            "lazy",
            "eager"
          ]
        }
      ]
    },
    "alert": {
      "label": "Uyarı Kutusu",
      "fields": [
        {
          "key": "icon",
          "label": "İkon",
          "type": "icon"
        },
        {
          "key": "content",
          "label": "İçerik",
          "type": "lang",
          "required": true
        }
      ]
    },
    "table": {
      "label": "Tablo",
      "fields": [
        {
          "key": "headers",
          "label": "Sütun Başlıkları",
          "type": "array",
          "itemLabel": "Sütun",
          "itemFields": [
            {
              "key": "tr",
              "label": "TR",
              "type": "text",
              "required": true
            },
            {
              "key": "en",
              "label": "EN",
              "type": "text",
              "required": true
            }
          ]
        },
        {
          "key": "rows",
          "label": "Satırlar",
          "type": "array",
          "itemLabel": "Satır",
          "itemFields": [
            {
              "key": "icon",
              "label": "İkon",
              "type": "icon"
            },
            {
              "key": "cells",
              "label": "Hücreler (JSON)",
              "type": "raw",
              "hint": "Örn: [{\"tr\":\"Birim\",\"en\":\"Unit\"}, \"1728\"]"
            },
            {
              "key": "highlightColumns",
              "label": "Vurgulanacak Sütunlar",
              "type": "array",
              "itemType": "number",
              "itemLabel": "Sütun No"
            }
          ]
        }
      ]
    },
    "hours-table": {
      "label": "Çalışma Saati Tablosu (Dinamik)",
      "description": "Her satırın en sağında saate/tarihe göre canlı Açık/Kapalı rozeti gösteren çalışma saatleri tablosu. Günler, saat aralıkları, öğle arası ve tatil istisnaları destekler.",
      "fields": [
        {
          "key": "id",
          "label": "ID (çapa)",
          "type": "text"
        },
        {
          "key": "title",
          "label": "Tablo Başlığı",
          "type": "lang"
        },
        {
          "key": "columns",
          "label": "Sütunlar",
          "type": "array",
          "itemLabel": "Sütun",
          "itemFields": [
            {
              "key": "label",
              "label": "Sütun Başlığı",
              "type": "lang"
            },
            {
              "key": "kind",
              "label": "Tür",
              "type": "select",
              "options": [
                "name",
                "schedule",
                "status"
              ],
              "hint": "name = satır adı sütunu · schedule = saat sütunu (satırların programları sırayla eşleşir) · status = durum rozeti sütunu"
            }
          ]
        },
        {
          "key": "holidays",
          "label": "Resmi Tatiller",
          "type": "array",
          "itemType": "date",
          "itemLabel": "Tarih",
          "hint": "Bu tarihlerde tüm satırlar kapalı sayılır; 'tatil istisnası' eklenen satırlar açık kalır"
        },
        {
          "key": "rows",
          "label": "Satırlar (Günler / Bölümler)",
          "type": "array",
          "itemLabel": "Satır",
          "itemFields": [
            {
              "key": "name",
              "label": "Ad",
              "type": "lang"
            },
            {
              "key": "icon",
              "label": "İkon",
              "type": "icon"
            },
            {
              "key": "schedules",
              "label": "Zaman Programları (sütun sırasıyla)",
              "type": "array",
              "itemLabel": "Program",
              "hint": "Her program tablodaki bir 'saat' sütununa karşılık gelir — sırası önemli",
              "itemFields": [
                {
                  "key": "label",
                  "label": "Program Etiketi (opsiyonel)",
                  "type": "lang",
                  "hint": "Boşsa gün seçimine göre otomatik: Hafta İçi / Cumartesi / Pazar"
                },
                {
                  "key": "days",
                  "label": "Geçerli Günler",
                  "type": "day-multiselect",
                  "hint": "Bu programın geçerli olduğu günleri işaretle (0=Pazar … 6=Cumartesi)"
                },
                {
                  "key": "periods",
                  "label": "Saat Aralıkları",
                  "type": "array",
                  "itemLabel": "Aralık",
                  "hint": "Birden fazla aralık eklenirse aralarındaki boşluk 'Öğle Arası' sayılır. 00:00-23:59 → 7/24 görünür",
                  "itemFields": [
                    {
                      "key": "open",
                      "label": "Açılış",
                      "type": "time"
                    },
                    {
                      "key": "close",
                      "label": "Kapanış",
                      "type": "time"
                    }
                  ]
                },
                {
                  "key": "closed",
                  "label": "Kapalı (tüm gün)",
                  "type": "boolean"
                }
              ]
            },
            {
              "key": "exceptions",
              "label": "Tatil İstisnaları",
              "type": "array",
              "itemLabel": "İstisna",
              "hint": "Resmi tatilde bu satır açık kalsın: tarih seç + 'açık' işaretle (saat boşsa normal programa bakar)",
              "itemFields": [
                {
                  "key": "date",
                  "label": "Tarih",
                  "type": "date"
                },
                {
                  "key": "open",
                  "label": "Bu tarihte açık",
                  "type": "boolean"
                },
                {
                  "key": "openTime",
                  "label": "Açılış (opsiyonel)",
                  "type": "time"
                },
                {
                  "key": "closeTime",
                  "label": "Kapanış (opsiyonel)",
                  "type": "time"
                }
              ]
            }
          ]
        }
      ]
    },
    "contact-buttons": {
      "label": "İletişim Butonları",
      "fields": [
        {
          "key": "buttons",
          "label": "Butonlar",
          "type": "array",
          "itemLabel": "Buton",
          "itemFields": [
            {
              "key": "type",
              "label": "Tip",
              "type": "select",
              "options": [
                "phone",
                "email",
                "link"
              ],
              "hint": "phone: telefon · email: e-posta · link: harici bağlantı"
            },
            {
              "key": "text",
              "label": "Metin",
              "type": "text"
            },
            {
              "key": "href",
              "label": "Bağlantı",
              "type": "url"
            },
            {
              "key": "icon",
              "label": "İkon",
              "type": "icon"
            }
          ]
        },
        {
          "key": "layout",
          "label": "Düzen",
          "type": "text"
        },
        {
          "key": "gap",
          "label": "Boşluk",
          "type": "text"
        },
        {
          "key": "justify",
          "label": "Hizalama",
          "type": "select",
          "options": [
            "center",
            "start",
            "end",
            "space-between"
          ]
        }
      ]
    }
  }
}
