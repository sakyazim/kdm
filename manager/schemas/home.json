{
  "file": "data/pages/home.json",
  "label": "Ana Sayfa Ayarları",
  "description": "Ana sayfanın bölüm ayarları: slider davranışı, haber/duyuru/yeni gelen bölümlerinin hangi JSON dosyalarından beslendiği ve tüm çeviri metinleri.",
  "fields": [
    {
      "key": "pageId",
      "label": "Sayfa Kimliği",
      "type": "text",
      "readonly": true,
      "hint": "Kilitli — yalnızca JSON dosyasından değiştirilebilir (yönlendirme için kullanılır)"
    },
    {
      "key": "pageType",
      "label": "Sayfa Tipi",
      "type": "text",
      "readonly": true,
      "hint": "Kilitli — yalnızca JSON dosyasından değiştirilebilir"
    },    {
      "key": "meta",
      "label": "SEO Bilgileri",
      "type": "object",
      "fields": [
        { "key": "title", "label": "Sayfa Başlığı (title)", "type": "lang", "hint": "Sekme başlığı — iç sayfalarda otomatik \" | Anadolu Üniversitesi Kütüphane\" eklenir" },
        { "key": "description", "label": "Açıklama (description)", "type": "lang", "hint": "Google sonuçlarında görünen 150-160 karakterlik özet" },
        { "key": "keywords", "label": "Anahtar Kelimeler", "type": "lang", "hint": "Virgülle ayırın" },
        { "key": "ogImage", "label": "Paylaşım Görseli (og:image)", "type": "image", "hint": "1200x630 önerilir. 🖼 Seç ile assets/images klasöründen seçilebilir; tam URL de yazılabilir" },
        { "key": "ogType", "label": "İçerik Tipi (og:type)", "type": "text", "hint": "website (anasayfa) / article (iç sayfa) — boşsa otomatik" },
        { "key": "section", "label": "Bölüm (article:section)", "type": "lang" },
        { "key": "author", "label": "Yazar", "type": "lang" },
        { "key": "publishedTime", "label": "Yayın Tarihi", "type": "date", "hint": "article:published_time için" },
        { "key": "tags", "label": "Etiketler (article:tag)", "type": "array", "itemType": "text", "itemLabel": "Etiket" },
        { "key": "searchUrlTemplate", "label": "Arama URL Şablonu", "type": "text", "readonly": true, "hint": "🔒 Sabit — katalog (libra) arama adresi, değiştirmeyin" },
        { "key": "logo", "label": "Logo URL", "type": "text" },
        {
          "key": "openingHours",
          "label": "Çalışma Saatleri (Google Şeması)",
          "type": "array",
          "itemLabel": "Saat Aralığı",
