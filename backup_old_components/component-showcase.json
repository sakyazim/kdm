    {
      "id": "step-card-components",
      "title": "Step Card Bileşeni",
      "icon": "fas fa-tasks",
      "description": "Accordion tarzı adım kartları. Numaralı, açılır/kapanır içerikli.",
      "componentCount": 2,
      "showJson": true,
      "variants": [
        {
          "label": "ORCID Profil Oluşturma Adımları",
          "component": {
            "type": "step-cards",
            "variant": "accordion",
            "data": {
              "steps": [
                {
                  "number": 1,
                  "title": "ORCID.org Sitesine Gidin",
                  "content": "<p>Tarayıcınızda <strong>https://orcid.org</strong> adresine gidin ve sağ üst köşede bulunan <strong>'Register'</strong> (Kaydol) butonuna tıklayın.</p>",
                  "defaultOpen": true
                },
                {
                  "number": 2,
                  "title": "Kayıt Formunu Doldurun",
                  "content": "<ul><li><strong>Ad ve Soyad:</strong> Akademik yayınlarınızda kullandığınız ismi girin</li><li><strong>E-posta:</strong> Kurumsal e-posta adresinizi (@anadolu.edu.tr) kullanın</li><li><strong>Şifre:</strong> Güçlü bir şifre oluşturun</li><li><strong>Gizlilik:</strong> Profilinizin görünürlüğünü ayarlayın (Public önerilir)</li></ul>",
                  "defaultOpen": false
                },
                {
                  "number": 3,
                  "title": "E-posta Doğrulaması",
                  "content": "<p>Kayıt işleminden sonra e-posta adresinize bir doğrulama linki gönderilecektir. Bu linke tıklayarak hesabınızı aktif hale getirin.</p>",
                  "defaultOpen": false
                },
                {
                  "number": 4,
                  "title": "Profilinizi Tamamlayın",
                  "content": "<p>ORCID hesabınıza giriş yapın ve profilinize şu bilgileri ekleyin:</p><ul><li>Kurumunuz (Anadolu Üniversitesi)</li><li>Eğitim geçmişiniz</li><li>İş deneyiminiz</li><li>Yayınlarınız</li><li>Diğer akademik kimlikleriniz (Scopus ID, ResearcherID, vb.)</li></ul>",
                  "defaultOpen": false
                }
              ]
            }
          }
        },
        {
          "label": "Mendeley ile Başlangıç Adımları",
          "component": {
            "type": "step-cards",
            "variant": "accordion",
            "data": {
              "steps": [
                {
                  "number": 1,
                  "title": "Mendeley Hesabı Oluşturun",
                  "content": "<p><strong>https://www.mendeley.com</strong> adresine gidin ve kurumsal e-posta adresinizle (@anadolu.edu.tr) kayıt olun. Kurumsal hesap ile sınırsız depolama ve gelişmiş özelliklere erişebilirsiniz.</p>",
                  "defaultOpen": true
                },
                {
                  "number": 2,
                  "title": "Masaüstü Uygulamasını İndirin",
                  "content": "<p>Mendeley Reference Manager (Masaüstü) uygulamasını bilgisayarınıza indirin ve kurun. Windows, Mac ve Linux sürümleri mevcuttur.</p>",
                  "defaultOpen": false
                },
                {
                  "number": 3,
                  "title": "Kaynakları İçe Aktarın",
                  "content": "<p>Mevcut kaynaklarınızı Mendeley'e ekleyin:</p><ul><li>PDF dosyalarını sürükle-bırak ile ekleyin</li><li>Web Importer eklentisi ile tarayıcıdan ekleyin</li><li>DOI, PubMed ID ile arama yapın</li><li>Diğer referans yöneticilerinden (EndNote, Zotero) içe aktarın</li></ul>",
                  "defaultOpen": false
                },
                {
                  "number": 4,
                  "title": "Word Eklentisini Kurun",
                  "content": "<p>Mendeley Cite eklentisini Microsoft Word veya LibreOffice'e kurun. Böylece dokümanlarınıza otomatik alıntı ekleyebilir ve bibliyografya oluşturabilirsiniz.</p>",
                  "defaultOpen": false
                },
                {
                  "number": 5,
                  "title": "Klasörler ve Etiketler Oluşturun",
                  "content": "<p>Kaynaklarınızı organize etmek için klasörler ve etiketler kullanın. Proje bazlı klasörler oluşturarak kolayca erişim sağlayabilirsiniz.</p>",
                  "defaultOpen": false
                }
              ]
            }
          }
        }
      ]
