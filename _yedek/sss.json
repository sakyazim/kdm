    {
      "id": "faq-genel",
      "components": [
        {
          "type": "heading",
          "variant": "single-icon",
          "data": {
            "title": {
              "tr": "Genel Bilgiler",
              "en": "General Information"
            },
            "icon": "fas fa-info-circle",
            "id": "faq-genel-heading"
          }
        },
        {
          "type": "accordion",
          "data": {
            "parentId": "faq-genel",
            "items": [
              {
                "id": "genel-1",
                "question": {
                  "tr": "Kütüphane Hangi Saatlerde Açık?",
                  "en": "What Are the Library Opening Hours?"
                },
                "answer": {
                  "tr": [
                    {
                      "type": "content",
                      "data": {
                        "content": "Güncel çalışma saatleri için [kütüphane web sitesini](http://kdm.anadolu.edu.tr) ziyaret edebilirsiniz."
                      }
                    },
                    {
                      "type": "info-box",
                      "data": {
                        "titleIcon": "fas fa-lightbulb",
                        "title": "İpucu",
                        "content": "Özel günlerde (sınav dönemleri, tatiller) çalışma saatleri değişebilir. Web sitesinden güncel bilgileri takip etmenizi öneririz."
                      }
                    }
                  ],
                  "en": [
                    {
                      "type": "content",
                      "data": {
                        "content": "For current opening hours, you can visit the [library website](http://kdm.anadolu.edu.tr)."
                      }
                    },
                    {
                      "type": "info-box",
                      "data": {
                        "titleIcon": "fas fa-lightbulb",
                        "title": "Tip",
                        "content": "Opening hours may change on special days (exam periods, holidays). We recommend following current information from the website."
                      }
                    }
                  ]
                }
              },
              {
                "id": "genel-2",
                "question": {
                  "tr": "Kütüphane ile İlgili Bilgi Almak İçin Nereye Başvurabilirim?",
                  "en": "Where Can I Get Information About the Library?"
                },
                "answer": {
                  "tr": [
                    {
                      "type": "icon-list",
                      "data": {
                        "items": [
                          {
                            "icon": "fas fa-envelope",
                            "title": "E-posta:",
                            "description": "[library@anadolu.edu.tr](mailto:library@anadolu.edu.tr)"
                          },
                          {
                            "icon": "fas fa-phone",
                            "title": "Telefon:",
                            "description": "[(222) 335 05 80 / 1733](tel:+902223350580)"
                          },
                          {
                            "icon": "fas fa-user-tie",
                            "title": "Yüz yüze:",
                            "description": "Danışma Bölümü'ndeki danışman kütüphanecilere başvurabilirsiniz."
                          }
                        ]
                      }
                    }
                  ],
                  "en": [
                    {
                      "type": "icon-list",
                      "data": {
                        "items": [
                          {
                            "icon": "fas fa-envelope",
                            "title": "Email:",
                            "description": "[library@anadolu.edu.tr](mailto:library@anadolu.edu.tr)"
                          },
                          {
                            "icon": "fas fa-phone",
                            "title": "Phone:",
                            "description": "[(222) 335 05 80 / 1733](tel:+902223350580)"
                          },
                          {
                            "icon": "fas fa-user-tie",
                            "title": "In person:",
                            "description": "You can contact reference librarians at the Reference Department."
                          }
                        ]
                      }
                    }
                  ]
                }
              },
              {
                "id": "genel-3",
                "question": {
                  "tr": "Üniversiteye Yeni Kayıt Oldum. Nasıl Kitap Ödünç Alabilirim?",
                  "en": "I'm Newly Enrolled at the University. How Can I Borrow Books?"
                },
                "answer": {
                  "tr": [
                    {
                      "type": "content",
                      "data": {
                        "content": "Yeni kayıt yaptıran öğrenciler, otomatik olarak kütüphane sistemine kaydedilir."
                      }
                    },
                    {
                      "type": "alert",
                      "variant": "info",
                      "data": {
                        "icon": "fas fa-info-circle",
                        "title": "Yapmanız gereken:",
                        "content": "Eskişehir'deki ikamet adresinizi ödünç verme servisinde kaydettirerek kitap almaya başlayabilirsiniz. Ödünç Verme Servisi kütüphane giriş katında bulunmaktadır."
                      }
                    }
                  ],
                  "en": [
                    {
                      "type": "content",
                      "data": {
                        "content": "Newly enrolled students are automatically registered in the library system."
                      }
                    },
                    {
                      "type": "alert",
                      "variant": "info",
                      "data": {
                        "icon": "fas fa-info-circle",
                        "title": "What you need to do:",
                        "content": "You can start borrowing books by registering your Eskişehir residence address at the circulation service. The Circulation Service is located on the ground floor of the library."
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
