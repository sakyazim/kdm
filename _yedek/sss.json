              },
              {
                "id": "odunc-2",
                "question": {
                  "tr": "Kitap Süresini Nasıl Uzatabilirim?",
                  "en": "How Can I Renew My Books?"
                },
                "answer": {
                  "tr": [
                    {
                      "type": "icon-list",
                      "data": {
                        "title": "Uzatma Yöntemleri",
                        "titleIcon": "fas fa-laptop",
                        "items": [
                          {
                            "icon": "fas fa-globe",
                            "title": "Web üzerinden",
                            "description": "[libra.anadolu.edu.tr](http://libra.anadolu.edu.tr)"
                          },
                          {
                            "icon": "fas fa-building",
                            "title": "Kütüphaneye gelerek",
                            "description": "Ödünç bankosundan"
                          },
                          {
                            "icon": "fas fa-desktop",
                            "title": "Ödünç istasyonlarını kullanarak",
                            "description": "Kütüphane içindeki self-servis noktalar"
                          }
                        ]
                      }
                    },
                    {
                      "type": "alert",
                      "variant": "warning",
                      "data": {
                        "icon": "fas fa-exclamation-triangle",
                        "title": "Önemli Şartlar:",
                        "items": [
                          "Kitap başka biri tarafından ayırtılmamış olmalı",
                          "İade süresi geçmemiş olmalı",
                          "En fazla 3 kez uzatma yapılabilir",
                          "**Telefonla uzatma yapılamaz!**"
                        ]
                      }
                    }
                  ],
                  "en": [
                    {
                      "type": "icon-list",
                      "data": {
                        "title": "Renewal Methods",
                        "titleIcon": "fas fa-laptop",
                        "items": [
                          {
                            "icon": "fas fa-globe",
                            "title": "Online",
                            "description": "[libra.anadolu.edu.tr](http://libra.anadolu.edu.tr)"
                          },
                          {
                            "icon": "fas fa-building",
                            "title": "Visit the library",
                            "description": "At the circulation desk"
                          },
                          {
                            "icon": "fas fa-desktop",
                            "title": "Using circulation stations",
                            "description": "Self-service points in the library"
                          }
                        ]
                      }
                    },
