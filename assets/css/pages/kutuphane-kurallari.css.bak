/* ============================================
   Kütüphane Kuralları Sayfası Stilleri
   ILL Sayfası Stiline Göre Düzenlenmiştir
   ============================================ */

/* Page Layout */
.library-rules-page .row {
  position: relative;
}

/* Info Cards - Modern & Clean Design */
.info-card {
  background: var(--bg-card);
  border-radius: var(--border-radius);
  box-shadow: var(--shadow-soft);
  border: 1px solid var(--border-color);
  margin-bottom: 1.5rem;
  overflow: hidden;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  position: relative;
}

.info-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-hover);
}

/* Card Header */
.info-card .card-header {
  background: white;
  color: var(--primary-color);
  padding: 1rem 1.5rem;
  font-weight: 600;
  font-size: 1.1rem;
  border-bottom: 2px solid var(--border-color);
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.info-card .card-header i {
  font-size: 1.3rem;
}

.info-card .card-body {
  padding: 1.75rem;
}

/* Rules Grid - ILL Stilinde */
.rules-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.5rem;
  margin-top: 1rem;
}

.rule-item {
  background: var(--bg-card);
  border: 2px solid var(--border-color);
  border-radius: var(--border-radius);
  padding: 1.5rem;
  transition: all 0.3s ease;
  border-top: 4px solid var(--primary-color);
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.rule-item:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow-hover);
  border-color: var(--primary-color);
}

.rule-icon {
  width: 45px;
  height: 45px;
  background: var(--primary-color);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.3rem;
  flex-shrink: 0;
  box-shadow: var(--shadow-soft);
}

.rule-content h5 {
  color: var(--primary-color);
  font-size: 1.05rem;
  font-weight: 700;
  margin-bottom: 0.5rem;
}

.rule-content p {
  margin-bottom: 0;
  font-size: 0.9rem;
  line-height: 1.6;
  color: var(--text-color);
}

/* Warning/Note Box */
.warning-box,
.note-box {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  padding: 1rem;
  background: var(--tertiary-color);
  border-radius: var(--border-radius);
  border-left: 4px solid var(--secondary-color);
  margin-top: 1rem;
}

.note-box {
  border-left-color: var(--primary-color);
}

.warning-box i,
.note-box i {
  color: var(--secondary-color);
  font-size: 1.2rem;
  flex-shrink: 0;
  margin-top: 0.2rem;
}

.note-box i {
  color: var(--primary-color);
}

.warning-box .warning-content,
.note-box .note-content {
  flex: 1;
}

.warning-box .warning-title,
.note-box .note-title {
  font-weight: 700;
  color: var(--text-color);
  margin-bottom: 0.25rem;
  font-size: 0.95rem;
}

.warning-box p,
.note-box p {
  margin: 0;
  font-size: 0.9rem;
  line-height: 1.6;
  color: var(--text-color);
}

/* Contact Box */
.contact-box {
  background: var(--tertiary-color);
  border-radius: var(--border-radius);
  padding: 1.5rem;
  margin-top: 1.5rem;
  border-left: 4px solid var(--primary-color);
  text-align: center;
}

.contact-box h5 {
  color: var(--primary-color);
  font-weight: 700;
  margin-bottom: 1rem;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  font-size: 1.1rem;
}

.contact-box p {
  color: var(--text-color);
  margin-bottom: 1rem;
  font-size: 0.95rem;
}

.contact-links {
  display: flex;
  gap: 1rem;
  justify-content: center;
  flex-wrap: wrap;
}

.contact-link {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.6rem 1.2rem;
  background: var(--bg-card);
  color: var(--primary-color) !important;
  text-decoration: none;
  border-radius: 20px;
  transition: all 0.3s ease;
  font-weight: 600;
  border: 2px solid var(--primary-color);
  font-size: 0.9rem;
}

.contact-link:hover {
  background: var(--primary-color);
  color: white !important;
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(31, 76, 138, 0.25);
}

/* Responsive Design */
@media (max-width: 768px) {
  .library-rules-page {
    padding: 1rem 0;
  }

  .rules-grid {
    grid-template-columns: 1fr;
  }

  .rule-item {
    padding: 1.25rem;
  }

  .contact-links {
    flex-direction: column;
    align-items: stretch;
  }

  .contact-link {
    justify-content: center;
  }

  .contact-box {
    padding: 1.25rem;
  }

  .contact-box h5 {
    font-size: 1rem;
    flex-direction: column;
    gap: 0.5rem;
  }

  .info-card .card-body {
    padding: 1.25rem;
  }
}

/* Animation for cards */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.info-card {
  animation: fadeInUp 0.5s ease-out;
}

/* Dark Theme Adjustments */
html[data-theme="dark"] .info-card .card-header {
  background: var(--bg-card);
  color: var(--primary-light);
  border-bottom-color: var(--border-color);
}

html[data-theme="dark"] .rule-icon {
  background: var(--primary-light);
}

html[data-theme="dark"] .rule-content h5 {
  color: var(--primary-light);
}

html[data-theme="dark"] .warning-box,
html[data-theme="dark"] .note-box {
  background: var(--tertiary-color);
}

html[data-theme="dark"] .contact-link {
  background: var(--bg-card);
  border-color: var(--primary-light);
  color: var(--primary-light) !important;
}

html[data-theme="dark"] .contact-link:hover {
  background: var(--primary-light);
  color: var(--bg-card) !important;
}

/* Print Styles */
@media print {
  .library-rules-page {
    background: white;
  }

  .rule-item,
  .warning-box,
  .note-box,
  .contact-box {
    page-break-inside: avoid;
    box-shadow: none;
  }

  .contact-link {
    background: transparent;
    color: black !important;
    border: 1px solid black;
  }

  .info-card:hover {
    transform: none;
    box-shadow: var(--shadow-soft);
  }
}
