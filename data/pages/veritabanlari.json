              {
                "id": "Sosyal Bilimler",
                "label": {
                  "tr": "Sosyal Bilimler",
                  "en": "Social Sciences"
                },
                "icon": "bi bi-people"
              },
              {
                "id": "İnsani Bilimler",
                "label": {
                  "tr": "İnsani Bilimler",
                  "en": "Humanities"
                },
                "icon": "bi bi-book"
              },
              {
                "id": "Atıf/Bilimsel Literatür",
