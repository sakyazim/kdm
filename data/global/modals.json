  "modals": [
    {
      "id": "kutuphane-hizmetleri",
      "category": "anasayfa",
      "label": {
        "tr": "Kütüphane Hizmetleri Tanıtımı",
        "en": "Library Services Overview"
      },
      "html": {
        "tr": "<div class=\"modal-feature-grid\">\n  <div class=\"modal-feature\"><i class=\"bi bi-book\"></i><h4>Kitap Ödünç</h4><p>Üyelik kartınızla 30 gün boyunca ödünç alabilirsiniz.</p></div>\n  <div class=\"modal-feature\"><i class=\"bi bi-globe\"></i><h4>Uzaktan Erişim</h4><p>E-kaynaklara her yerden ulaşın.</p></div>\n  <div class=\"modal-feature\"><i class=\"bi bi-people\"></i><h4>Çalışma Odaları</h4><p>Grup çalışmaları için oda rezervasyonu.</p></div>\n</div>\n<p class=\"modal-note\">Tüm hizmetler <strong>kütüphane kartınızla</strong> ücretsizdir. Detaylar için <a href=\"kutuphane-kullanim-klavuzu.html\">kullanım kılavuzunu</a> inceleyin.</p>",
        "en": "<div class=\"modal-feature-grid\">\n  <div class=\"modal-feature\"><i class=\"bi bi-book\"></i><h4>Book Lending</h4><p>Borrow for 30 days with your membership card.</p></div>\n  <div class=\"modal-feature\"><i class=\"bi bi-globe\"></i><h4>Remote Access</h4><p>Access e-resources from anywhere.</p></div>\n  <div class=\"modal-feature\"><i class=\"bi bi-people\"></i><h4>Study Rooms</h4><p>Book rooms for group work.</p></div>\n</div>\n<p class=\"modal-note\">All services are <strong>free with your library card</strong>. See the <a href=\"kutuphane-kullanim-klavuzu.html\">user guide</a> for details.</p>"
      }
    },
    {
      "id": "sistem-bakim",
      "category": "duyurular",
      "label": {
        "tr": "Sistem Bakımı Bildirimi",
        "en": "System Maintenance Notice"
      },
      "html": {
        "tr": "<div class=\"modal-alert\"><i class=\"bi bi-exclamation-triangle\"></i><div><strong>Planlı bakım çalışması</strong><p>Katalog ve e-kaynak sistemlerinde kısa süreli kesinti yaşanabilir.</p></div></div>\n<ul class=\"modal-list\">\n  <li><i class=\"bi bi-clock\"></i> <strong>Tarih:</strong> Cumartesi 22:00 – Pazar 02:00</li>\n  <li><i class=\"bi bi-plug\"></i> <strong>Etkilenen:</strong> Katalog arama, e-kaynak erişimi</li>\n  <li><i class=\"bi bi-check-circle\"></i> <strong>Etkilenmeyen:</strong> Ödünç/iade, çalışma alanları</li>\n</ul>",
        "en": "<div class=\"modal-alert\"><i class=\"bi bi-exclamation-triangle\"></i><div><strong>Scheduled maintenance</strong><p>Brief interruptions may occur in catalog and e-resource systems.</p></div></div>\n<ul class=\"modal-list\">\n  <li><i class=\"bi bi-clock\"></i> <strong>When:</strong> Saturday 22:00 – Sunday 02:00</li>\n  <li><i class=\"bi bi-plug\"></i> <strong>Affected:</strong> Catalog search, e-resource access</li>\n  <li><i class=\"bi bi-check-circle\"></i> <strong>Not affected:</strong> Lending, study areas</li>\n</ul>"
      }
    },
    {
      "id": "sorun-bildir",
      "category": "help",
      "label": {
        "tr": "Sorun Bildir",
        "en": "Report an Issue"
      },
      "html": {
        "tr": "<p class=\"modal-lead\">Bir sorun mu yaşıyorsunuz? Aşağıdaki formu doldurun, ekibimiz en kısa sürede dönüş yapsın.</p>\n<form class=\"modal-form\" id=\"issueForm\" onsubmit=\"return false;\">\n  <div class=\"form-row\">\n    <div class=\"form-group\"><label>Adınız Soyadınız *</label><input type=\"text\" placeholder=\"Ad Soyad\" required></div>\n    <div class=\"form-group\"><label>E-posta *</label><input type=\"email\" placeholder=\"ornek@anadolu.edu.tr\" required></div>\n  </div>\n  <div class=\"form-group\"><label>Konu *</label><select required><option value=\"\">Seçin…</option><option>Erişim sorunu</option><option>Katalog hatası</option><option>Ödünç/iade</option><option>Diğer</option></select></div>\n  <div class=\"form-group\"><label>Sorun Detayı *</label><textarea rows=\"4\" placeholder=\"Karşılaştığınız sorunu açıklayın…\" required></textarea></div>\n  <label class=\"form-check\"><input type=\"checkbox\"> Bana e-posta ile dönüş yapılsın</label>\n  <button type=\"submit\" class=\"btn btn-primary modal-form-btn\"><i class=\"bi bi-send\"></i> Gönder</button>\n</form>\n<p class=\"modal-micro\">Form doldurmak istemiyorsanız: <a href=\"mailto:kutuphane@anadolu.edu.tr\">kutuphane@anadolu.edu.tr</a></p>",
        "en": "<p class=\"modal-lead\">Experiencing an issue? Fill out the form below and our team will get back to you shortly.</p>\n<form class=\"modal-form\" id=\"issueForm\" onsubmit=\"return false;\">\n  <div class=\"form-row\">\n    <div class=\"form-group\"><label>Full Name *</label><input type=\"text\" placeholder=\"First Last\" required></div>\n    <div class=\"form-group\"><label>Email *</label><input type=\"email\" placeholder=\"you@anadolu.edu.tr\" required></div>\n  </div>\n  <div class=\"form-group\"><label>Subject *</label><select required><option value=\"\">Select…</option><option>Access issue</option><option>Catalog error</option><option>Lending</option><option>Other</option></select></div>\n  <div class=\"form-group\"><label>Issue Details *</label><textarea rows=\"4\" placeholder=\"Describe the issue…\" required></textarea></div>\n  <label class=\"form-check\"><input type=\"checkbox\"> Email me back</label>\n  <button type=\"submit\" class=\"btn btn-primary modal-form-btn\"><i class=\"bi bi-send\"></i> Submit</button>\n</form>\n<p class=\"modal-micro\">Prefer email? Write to: <a href=\"mailto:kutuphane@anadolu.edu.tr\">kutuphane@anadolu.edu.tr</a></p>"
      }
    },
    {
      "id": "kutuphane-degerlendirme",
      "category": "help",
      "label": {
        "tr": "Kütüphane Değerlendirme",
        "en": "Library Feedback"
      },
      "html": {
        "tr": "<p class=\"modal-lead\">Deneyiminizi değerlendirin — hizmetlerimizi iyileştirmemize yardımcı olun.</p>\n<form class=\"modal-form\" onsubmit=\"return false;\">\n  <div class=\"form-group\"><label>Genel Memnuniyet</label>\n    <div class=\"star-rating\"><span data-v=\"1\">★</span><span data-v=\"2\">★</span><span data-v=\"3\">★</span><span data-v=\"4\">★</span><span data-v=\"5\">★</span></div>\n  </div>\n  <div class=\"form-row\">\n    <div class=\"form-group\"><label>Kullandığınız Hizmet</label><select><option>Katalog</option><option>E-kaynaklar</option><option>Çalışma alanları</option><option>Ödünç/iade</option></select></div>\n    <div class=\"form-group\"><label>Puan (1-5)</label><input type=\"number\" min=\"1\" max=\"5\" placeholder=\"5\"></div>\n  </div>\n  <div class=\"form-group\"><label>Yorumunuz</label><textarea rows=\"4\" placeholder=\"Öneri ve görüşleriniz…\"></textarea></div>\n  <button type=\"submit\" class=\"btn btn-primary modal-form-btn\"><i class=\"bi bi-star\"></i> Değerlendirmeyi Gönder</button>\n</form>",
        "en": "<p class=\"modal-lead\">Rate your experience — help us improve our services.</p>\n<form class=\"modal-form\" onsubmit=\"return false;\">\n  <div class=\"form-group\"><label>Overall Satisfaction</label>\n    <div class=\"star-rating\"><span data-v=\"1\">★</span><span data-v=\"2\">★</span><span data-v=\"3\">★</span><span data-v=\"4\">★</span><span data-v=\"5\">★</span></div>\n  </div>\n  <div class=\"form-row\">\n    <div class=\"form-group\"><label>Service Used</label><select><option>Catalog</option><option>E-resources</option><option>Study areas</option><option>Lending</option></select></div>\n    <div class=\"form-group\"><label>Rating (1-5)</label><input type=\"number\" min=\"1\" max=\"5\" placeholder=\"5\"></div>\n  </div>\n  <div class=\"form-group\"><label>Your Comments</label><textarea rows=\"4\" placeholder=\"Suggestions and feedback…\"></textarea></div>\n  <button type=\"submit\" class=\"btn btn-primary modal-form-btn\"><i class=\"bi bi-star\"></i> Submit Feedback</button>\n</form>"
      }
    },
    {
      "id": "yeni-veritabani",
      "category": "anasayfa",
      "label": {
        "tr": "Yeni Veritabanı Duyurusu",
        "en": "New Database Announcement"
      },
      "html": {
        "tr": "<div class=\"modal-hero\"><img src=\"assets/images/nopic.jpeg\" alt=\"Veritabanı\" onerror=\"this.style.display='none'\"><h4>Academic Research Plus</h4></div>\n<p class=\"modal-lead\">Kütüphanemize yeni eklenen veritabanı ile <strong>5000'den fazla akademik dergiye</strong> erişim sağlayabilirsiniz.</p>\n<ul class=\"modal-list\">\n  <li><i class=\"bi bi-journal\"></i> 5.000+ hakemli dergi</li>\n  <li><i class=\"bi bi-search\"></i> Gelişmiş arama araçları</li>\n  <li><i class=\"bi bi-download\"></i> PDF tam metin indirme</li>\n</ul>\n<a class=\"btn btn-primary\" href=\"veritabanlari.html\">Veritabanına Git <i class=\"bi bi-arrow-right\"></i></a>",
        "en": "<div class=\"modal-hero\"><img src=\"assets/images/nopic.jpeg\" alt=\"Database\" onerror=\"this.style.display='none'\"><h4>Academic Research Plus</h4></div>\n<p class=\"modal-lead\">Access <strong>over 5,000 academic journals</strong> with our newly added database.</p>\n<ul class=\"modal-list\">\n  <li><i class=\"bi bi-journal\"></i> 5,000+ peer-reviewed journals</li>\n  <li><i class=\"bi bi-search\"></i> Advanced search tools</li>\n  <li><i class=\"bi bi-download\"></i> PDF full-text download</li>\n</ul>\n<a class=\"btn btn-primary\" href=\"veritabanlari.html\">Go to Database <i class=\"bi bi-arrow-right\"></i></a>"
      }
    }
  ],
  "lastModified": "2026-08-15 12:00"
}